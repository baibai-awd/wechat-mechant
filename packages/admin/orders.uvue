<template>
  <scroll-view class="sc" style="flex: 1;">
    <view class="toolbar">
      <text class="t">订单列表</text>
    </view>
    <view class="tabs">
      <view v-for="(tab, i) in tabs" :key="'tab' + i.toString()" @click="switchTab(tab.key)">
        <text :class="curTab === tab.key ? 'tab-on' : 'tab-off'">{{ tab.label }}</text>
      </view>
    </view>
    <view v-if="loading" class="loading-row">
      <text class="loading-t">加载中...</text>
    </view>
    <view class="row" v-for="(o, i) in rows" :key="'o' + i.toString()" @click="goDetail(o.order_no)">
      <view class="row-hd">
        <text class="id">{{ o.order_no }}</text>
        <text :class="statusClass(o.status)">{{ o.statusText }}</text>
      </view>
      <text class="g">{{ o.goodsTitle }}</text>
      <view class="row-ft">
        <text class="tm">{{ o.time }}</text>
        <text class="total">¥{{ o.totalYuan }}</text>
      </view>
    </view>
    <view v-if="!loading && rows.length === 0" class="empty">
      <text class="empty-t">暂无订单</text>
    </view>
  </scroll-view>
</template>
<script setup lang="uts">
  import { getAdminToken } from '@/utils/admin-auth.uts'

  type OrderItem = {
    order_no: string
    status: string
    statusText: string
    goodsTitle: string
    totalYuan: string
    time: string
  }

  const tabs = [
    { key: '', label: '全部' },
    { key: 'paid', label: '待发货' },
    { key: 'shipped', label: '待收货' },
    { key: 'received', label: '已完成' },
    { key: 'closed', label: '已关闭' }
  ]

  const rows = ref<OrderItem[]>([])
  const curTab = ref('')
  const loading = ref(false)

  onLoad(() => {
    const token = getAdminToken()
    if (token.length === 0) {
      uni.redirectTo({ url: '/packages/admin/login' })
    }
  })

  onShow(() => {
    loadList()
  })

  function switchTab(key: string): void {
    curTab.value = key
    loadList()
  }

  function statusClass(status: string): string {
    if (status === 'paid') return 'st-paid'
    if (status === 'shipped') return 'st-shipped'
    if (status === 'received') return 'st-done'
    if (status === 'closed') return 'st-closed'
    return 'st-default'
  }

  async function loadList(): Promise<void> {
    loading.value = true
    const token = getAdminToken()
    try {
      // @ts-ignore
      const co = uniCloud.importObject('admin-co')
      const res = await co.getOrderList({ token, limit: 50, status: curTab.value }) as UTSJSONObject
      if (res['errCode'] != null && (res['errCode'] as number) === 0) {
        const arr = res['list'] as UTSJSONObject[]
        const out: OrderItem[] = []
        for (let i = 0; i < arr.length; i++) {
          const o = arr[i]
          out.push({
            order_no: (o['order_no'] as string) || '',
            status: (o['status'] as string) || '',
            statusText: (o['statusText'] as string) || '',
            goodsTitle: (o['goodsTitle'] as string) || '',
            totalYuan: (o['totalYuan'] as string) || '0.00',
            time: (o['time'] as string) || ''
          })
        }
        rows.value = out
      } else {
        rows.value = []
      }
    } catch (e) {
      rows.value = []
    } finally {
      loading.value = false
    }
  }

  function goDetail(order_no: string): void {
    uni.navigateTo({ url: '/packages/admin/order-detail?order_no=' + order_no })
  }
</script>
<style>
.sc { min-height: 100%; background-color: #f7f8fa; padding: 18px 14px 36px; box-sizing: border-box; }
.toolbar { height: 38px; display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.t { font-size: 22px; line-height: 30px; font-weight: 700; color: #111827; }
.tabs { margin-top: 12px; margin-bottom: 12px; padding: 4px; background-color: #eef2f7; border-radius: 8px; display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.tab-on, .tab-off { min-width: 58px; height: 34px; padding: 0 10px; border-radius: 7px; text-align: center; font-size: 13px; line-height: 34px; box-sizing: border-box; }
.tab-on { background-color: #ffffff; color: #0f766e; font-weight: 700; }
.tab-off { color: #64748b; font-weight: 600; }
.loading-row, .empty { padding: 36px 0; display: flex; align-items: center; justify-content: center; }
.loading-t, .empty-t { font-size: 14px; line-height: 20px; color: #94a3b8; }
.row { margin-bottom: 10px; padding: 14px; background-color: #ffffff; border: 1px solid #e6e8ec; border-radius: 8px; box-sizing: border-box; }
.row-hd, .row-ft { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.id { max-width: 220px; font-size: 13px; line-height: 18px; font-weight: 700; color: #1f2937; }
.g { display: block; margin-top: 10px; font-size: 14px; line-height: 20px; color: #475569; }
.tm { font-size: 12px; line-height: 18px; color: #94a3b8; }
.total { font-size: 16px; line-height: 22px; font-weight: 700; color: #111827; }
.st-paid, .st-shipped, .st-done, .st-closed, .st-default { padding: 3px 8px; border-radius: 8px; font-size: 12px; line-height: 16px; font-weight: 700; }
.st-paid { background-color: #fffbeb; color: #d97706; }
.st-shipped { background-color: #eff6ff; color: #2563eb; }
.st-done { background-color: #ecfdf5; color: #059669; }
.st-closed { background-color: #f1f5f9; color: #64748b; }
.st-default { background-color: #f8fafc; color: #64748b; }
</style>
