<template>
  <scroll-view class="sc" style="flex: 1;">
    <view class="toolbar">
      <text class="t">商品 SPUS</text>
      <view class="add" @click="edit('')">
        <text class="add-t">+ 新建</text>
      </view>
    </view>
    <view class="search-row">
      <input class="search-inp" placeholder="搜索商品名称" :value="kw" @input="onKw" />
      <view class="search-btn" @click="search">
        <text class="search-btn-t">搜索</text>
      </view>
    </view>
    <view v-if="loading" class="loading-row">
      <text class="loading-t">加载中...</text>
    </view>
    <view class="row" v-for="p in list" :key="p.id" @click="edit(p.id)">
      <image v-if="p.cover != null && p.cover.length > 0" class="thumb" :src="p.cover" mode="aspectFill" />
      <view v-else class="thumb" />
      <view class="mid">
        <text class="title">{{ p.title }}</text>
        <view class="meta-row">
          <text class="p">¥{{ p.priceYuan }}</text>
          <text v-if="p.tag" class="tag">{{ p.tag }}</text>
          <text :class="p.status === 'on_sale' ? 'status-on' : 'status-off'">{{ p.status === 'on_sale' ? '上架' : '下架' }}</text>
        </view>
        <text class="stock">库存: {{ p.stock }}</text>
      </view>
      <text class="a">编辑 ›</text>
    </view>
    <view v-if="!loading && list.length === 0" class="empty">
      <text class="empty-t">暂无商品</text>
    </view>
  </scroll-view>
</template>
<script setup lang="uts">
  import { getAdminToken } from '@/utils/admin-auth.uts'
  import { listMallProductBriefs } from '@/utils/mall-catalog.uts'

  type ProductItem = {
    id: string
    title: string
    priceYuan: string
    tag: string
    cover: string
    stock: number
    status: string
  }

  const list = ref<ProductItem[]>([])
  const kw = ref('')
  const loading = ref(false)

  onLoad(() => {
    const token = getAdminToken()
    if (token.length === 0) {
      uni.redirectTo({ url: '/packages/admin/login' })
    }
  })

  onShow(() => {
    loadList()
  })

  function onKw(e : UniInputEvent) {
    kw.value = e.detail.value || ''
  }

  function search() : void {
    loadList()
  }

  async function loadList() : Promise<void> {
    loading.value = true
    const token = getAdminToken()
    try {
      // @ts-ignore
      const co = uniCloud.importObject('admin-co')
      const res = await co.getProductList({ token, limit: 50, kw: kw.value }) as UTSJSONObject
      if (res['errCode'] != null && (res['errCode'] as number) === 0) {
        const arr = res['list'] as UTSJSONObject[]
        const out: ProductItem[] = []
        for (let i = 0; i < arr.length; i++) {
          const o = arr[i]
          out.push({
            id: o['id'] as string,
            title: o['title'] as string,
            priceYuan: o['priceYuan'] as string,
            tag: (o['tag'] as string) || '',
            cover: (o['cover'] as string) || '',
            stock: (o['stock'] as number) || 0,
            status: (o['status'] as string) || 'off'
          })
        }
        list.value = out
      } else {
        list.value = []
      }
    } catch (e) {
      list.value = []
    } finally {
      loading.value = false
    }
  }

  function edit(id : string) : void {
    if (id.length > 0) {
      uni.navigateTo({ url: '/packages/admin/product-edit?id=' + id })
    } else {
      uni.navigateTo({ url: '/packages/admin/product-edit' })
    }
  }
</script>
<style>
.sc { min-height: 100%; background-color: #f7f8fa; padding: 18px 14px 36px; box-sizing: border-box; }
.toolbar { height: 40px; display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.t { font-size: 22px; line-height: 30px; font-weight: 700; color: #111827; }
.add { height: 34px; padding: 0 12px; border-radius: 8px; background-color: #0f766e; display: flex; align-items: center; justify-content: center; }
.add-t { font-size: 13px; line-height: 18px; font-weight: 700; color: #ffffff; }
.search-row { margin-top: 14px; margin-bottom: 12px; display: flex; flex-direction: row; align-items: center; }
.search-inp { flex: 1; height: 40px; padding: 0 12px; background-color: #ffffff; border: 1px solid #e6e8ec; border-radius: 8px; font-size: 14px; color: #111827; box-sizing: border-box; }
.search-btn { width: 70px; height: 40px; margin-left: 8px; border-radius: 8px; background-color: #111827; display: flex; align-items: center; justify-content: center; }
.search-btn-t { font-size: 14px; line-height: 20px; font-weight: 700; color: #ffffff; }
.loading-row, .empty { padding: 36px 0; display: flex; align-items: center; justify-content: center; }
.loading-t, .empty-t { font-size: 14px; line-height: 20px; color: #94a3b8; }
.row { margin-bottom: 10px; padding: 12px; background-color: #ffffff; border: 1px solid #e6e8ec; border-radius: 8px; display: flex; flex-direction: row; align-items: center; box-sizing: border-box; }
.thumb { width: 68px; height: 68px; border-radius: 8px; background-color: #eef2f7; margin-right: 12px; }
.mid { flex: 1; min-width: 0; }
.title { display: block; font-size: 15px; line-height: 21px; font-weight: 700; color: #111827; }
.meta-row { margin-top: 7px; display: flex; flex-direction: row; align-items: center; flex-wrap: wrap; }
.p { margin-right: 8px; font-size: 15px; line-height: 20px; font-weight: 700; color: #0f766e; }
.tag, .status-on, .status-off { margin-right: 6px; padding: 2px 7px; border-radius: 8px; font-size: 11px; line-height: 15px; font-weight: 700; }
.tag { background-color: #fffbeb; color: #d97706; }
.status-on { background-color: #ecfdf5; color: #059669; }
.status-off { background-color: #f1f5f9; color: #64748b; }
.stock { display: block; margin-top: 6px; font-size: 12px; line-height: 17px; color: #94a3b8; }
.a { margin-left: 8px; font-size: 13px; line-height: 18px; color: #0f766e; font-weight: 700; }
</style>
