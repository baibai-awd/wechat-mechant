<template>
  <scroll-view class="sc" style="flex: 1;">
    <text class="oid">订单 {{ orderId }}</text>
    <view class="card" v-for="(s, i) in steps" :key="'k' + i.toString()">
      <view class="step-i">
        <text class="step-num">{{ (i + 1).toString() }}</text>
      </view>
      <text class="step-t">{{ s }}</text>
    </view>
  </scroll-view>
</template>
<script setup lang="uts">
  import { mockTrackSteps } from '@/utils/mall-mock.uts'

  const orderId = ref('—')
  const steps = ref<string[]>(mockTrackSteps())

  onLoad((options : OnLoadOptions) => {
    const id = options['orderId'] as string
    if (id != null && id.length > 0) {
      orderId.value = id
    }
  })
</script>
