<template>
  <scroll-view class="sc" style="flex: 1;">
    <view class="card">
      <text class="sec-t">头像</text>
      <view class="ava-row">
        <view class="avatar-lg">
          <text class="avatar-lg-t">用</text>
        </view>
        <text class="hint">演示环境不上传图片</text>
      </view>
    </view>
    <view class="card">
      <view class="field">
        <text class="k">昵称</text>
        <view class="v-wrap">
          <text v-if="nick.length === 0" class="v-ph">请输入昵称</text>
          <input class="v" :value="nick" @input="onNick" />
        </view>
      </view>
      <view class="field">
        <text class="k">性别</text>
        <text class="v2">保密</text>
      </view>
    </view>
    <view class="btn-main" @click="save">
      <text class="btn-main-t">保存</text>
    </view>
    <view class="btn-out" @click="logout">
      <text class="btn-out-t">退出登录</text>
    </view>
  </scroll-view>
</template>
<script setup lang="uts">
  import { clearMallAuth, getMallUserLabel, handleMallTokenInvalid } from '@/utils/mall-auth.uts'

  const nick = ref('商城用户')

  onShow(() => {
    const lab = getMallUserLabel()
    if (lab.length > 0) {
      nick.value = lab
    }
  })

  function onNick(e : UniInputEvent) {
    nick.value = e.detail.value
  }
  function save() : void {
    uni.showToast({ title: '已保存', icon: 'success' })
  }
  function logout() : void {
    clearMallAuth()
    uni.showToast({ title: '已退出', icon: 'none' })
    setTimeout(() => {
      uni.navigateBack({})
    }, 300)
  }
</script>
