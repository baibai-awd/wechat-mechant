<template>
  <scroll-view class="sc" style="flex: 1;">
    <view class="head">
      <view class="avatar">
        <text class="avatar-t">用</text>
      </view>
      <view class="head-m">
        <text class="nick">商城用户</text>
        <text class="sub">黄金会员 · 积分 1280</text>
      </view>
      <text class="edit" @click="goProfile">编辑 ›</text>
    </view>
    <view class="card">
      <view class="row" @click="goOrders">
        <text class="row-t">我的订单</text>
        <text class="row-a">›</text>
      </view>
      <view class="row" @click="goAddr">
        <text class="row-t">收货地址</text>
        <text class="row-a">›</text>
      </view>
      <view class="row" @click="goCoupon">
        <text class="row-t">优惠券</text>
        <text class="row-a">›</text>
      </view>
      <view class="row" @click="goSec">
        <text class="row-t">账户安全</text>
        <text class="row-a">›</text>
      </view>
    </view>
    <view class="btn-out" @click="outDemo">
      <text class="btn-out-t">退出登录（演示）</text>
    </view>
  </scroll-view>
</template>
<script setup lang="uts">
  import { getMallUniIdToken, mallNavigateTo } from '@/utils/mall-auth.uts'

  function goProfile() : void {
    mallNavigateTo('/packages/mall/user/profile')
  }
  function goOrders() : void {
    if (getMallUniIdToken().length === 0) {
      mallNavigateTo('/packages/mall/user/login')
      return
    }
    mallNavigateTo('/packages/mall/order/order-list')
  }
  function goAddr() : void {
    mallNavigateTo('/packages/mall/user/address-list')
  }
  function goCoupon() : void {
    mallNavigateTo('/packages/mall/pay/coupons')
  }
  function goSec() : void {
    mallNavigateTo('/packages/mall/user/security')
  }
  function outDemo() : void {
    uni.showToast({ title: '演示环境已退出', icon: 'none' })
  }
</script>
