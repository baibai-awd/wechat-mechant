<template>
  <scroll-view class="sc" style="flex: 1;">
    <view class="card">
      <text class="st">{{ tk.status }}</text>
      <text class="title">{{ tk.title }}</text>
      <text class="meta">工单号 {{ tk.id }} · {{ tk.time }}</text>
    </view>
    <view class="msg me">
      <text class="msg-t">用户：问题的补充说明（演示）</text>
    </view>
    <view class="msg cs">
      <text class="msg-t">客服：已收到，预计 24h 内回复。</text>
    </view>
  </scroll-view>
</template>
<script setup lang="uts">
  import { findMockTicket, type MockTicket } from '@/utils/mall-mock.uts'

  const tk = ref<MockTicket>(findMockTicket(''))

  onLoad((options : OnLoadOptions) => {
    const id = options['id'] as string
    if (id != null && id.length > 0) {
      tk.value = findMockTicket(id)
    }
  })
</script>
