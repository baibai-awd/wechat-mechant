<template>
  <scroll-view class="sc" style="flex: 1;">
    <view class="row" v-for="t in list" :key="t.id" @click="go(t.id)">
      <view class="mid">
        <text class="title">{{ t.title }}</text>
        <text class="time">{{ t.time }}</text>
      </view>
      <text class="st">{{ t.status }}</text>
    </view>
    <view class="fab" @click="newTk">
      <text class="fab-t">新建工单</text>
    </view>
  </scroll-view>
</template>
<script setup lang="uts">
  import { mockTickets, type MockTicket } from '@/utils/mall-mock.uts'

  const list = ref<MockTicket[]>(mockTickets())

  function go(id : string) : void {
    uni.navigateTo({ url: '/packages/mall/svc/ticket-detail?id=' + id })
  }
  function newTk() : void {
    uni.navigateTo({ url: '/packages/mall/svc/ticket-new' })
  }
</script>
