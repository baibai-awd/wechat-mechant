<template>
  <scroll-view class="sc" style="flex: 1;">
    <view class="card">
      <text class="amt">¥{{ row.amount }}</text>
      <text class="st">支付成功</text>
      <view class="line">
        <text class="k">流水号</text>
        <text class="v">{{ row.id }}</text>
