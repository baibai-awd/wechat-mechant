</template>
<script setup lang="uts">
  import { findMockBill, type MockBill } from '@/utils/mall-mock.uts'

  const row = ref<MockBill>(findMockBill(''))

  onLoad((options : OnLoadOptions) => {
    const id = options['id'] as string
    if (id != null && id.length > 0) {
      row.value = findMockBill(id)
    }
  })
</script>
