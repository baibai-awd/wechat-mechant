  color: #111827;
  min-width: 80px;
}
.max-amt {
  margin-left: 12px;
  font-size: 13px;
  color: #9ca3af;
}
.ta-wrap {
  position: relative;
  flex-direction: column;
}
.ta-ph {
  position: absolute;
  left: 0;
