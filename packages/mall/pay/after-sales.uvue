}
.img-item {
  margin-right: 10px;
  margin-bottom: 10px;
  position: relative;
}
.img-pre {
  width: 80px;
  height: 80px;
  border-radius: 10px;
}
.img-del {
  position: absolute;
  top: -6px;
  right: -6px;
  width: 20px;
  height: 20px;
  border-radius: 10px;
  background-color: rgba(0, 0, 0, 0.5);
  align-items: center;
