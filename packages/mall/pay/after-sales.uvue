  font-size: 14px;
  color: #ffffff;
  font-weight: 700;
}
.img-add {
  width: 80px;
  height: 80px;
  border-radius: 10px;
  border-width: 1px;
  border-color: #d1d5db;
  border-style: dashed;
  background-color: #f9fafb;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}
.img-add-t {
  font-size: 24px;
