<script setup lang="uts">
  import { findMockRefund, type MockRefund } from '@/utils/mall-mock.uts'

  const row = ref<MockRefund>(findMockRefund(''))

  onLoad((options : OnLoadOptions) => {
    const id = options['id'] as string
    if (id != null && id.length > 0) {
      row.value = findMockRefund(id)
    }
  })
</script>
