<template>
  <scroll-view class="sc" style="flex: 1;">
    <view class="row" v-for="b in list" :key="b.id" @click="go(b.id)">
      <view class="mid">
        <text class="t">{{ b.title }}</text>
        <text class="s">{{ b.time }} · {{ b.payMethod }}</text>
      </view>
      <text class="amt">¥{{ b.amount }}</text>
    </view>
  </scroll-view>
</template>
<script setup lang="uts">
  import { mockBills, type MockBill } from '@/utils/mall-mock.uts'

  const list = ref<MockBill[]>(mockBills())

  function go(id : string) : void {
    uni.navigateTo({ url: '/packages/mall/pay/bill-detail?id=' + id })
  }
</script>
