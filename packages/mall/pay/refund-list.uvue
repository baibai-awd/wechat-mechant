<template>
  <scroll-view class="sc" style="flex: 1;">
    <view class="row" v-for="r in list" :key="r.id" @click="go(r.id)">
      <view class="mid">
        <text class="t">{{ r.goodsTitle }}</text>
        <text class="s">{{ r.time }}</text>
      </view>
      <view class="right">
        <text class="st">{{ r.status }}</text>
        <text class="amt">¥{{ r.amount }}</text>
      </view>
    </view>
  </scroll-view>
</template>
<script setup lang="uts">
  import { mockRefunds, type MockRefund } from '@/utils/mall-mock.uts'

  const list = ref<MockRefund[]>(mockRefunds())

  function go(id : string) : void {
    uni.navigateTo({ url: '/packages/mall/pay/refund-detail?id=' + id })
  }
</script>
