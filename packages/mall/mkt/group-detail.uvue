<template>
  <scroll-view class="sc" style="flex: 1;">
    <view class="hero" />
    <view class="card">
      <text class="t">{{ brief.title }}</text>
      <text class="sub">{{ brief.sub }}</text>
      <view class="team">
        <text class="team-t">还差 1 人成团 · 剩余 23:59:08</text>
        <view class="avatars">
          <view class="av" v-for="i in 2" :key="'a' + i.toString()">
            <text class="av-i">{{ i === 1 ? '我' : '?' }}</text>
          </view>
        </view>
      </view>
      <view class="pr">
        <text class="g">¥{{ groupPrice }}</text>
        <text class="o">单独买 ¥{{ brief.priceYuan }}</text>
      </view>
    </view>
    <view class="btn-main" @click="goBuy">
      <text class="btn-t">参与拼团</text>
    </view>
  </scroll-view>
</template>
<script setup lang="uts">
  import { getProductBrief, type MallProductBrief } from '@/utils/mall-catalog.uts'

  const pid = ref('p2')
  const brief = ref<MallProductBrief>(getProductBrief('p2'))
  const groupPrice = ref('99.00')

  onLoad((options : OnLoadOptions) => {
    const id = options['productId'] as string
    if (id != null && id.length > 0) {
      pid.value = id
    }
    brief.value = getProductBrief(pid.value)
    const p = parseFloat(brief.value.priceYuan)
    groupPrice.value = (p * 0.88).toFixed(2)
  })

  function goBuy() : void {
    uni.navigateTo({ url: '/packages/mall/shop/product-detail?id=' + pid.value })
  }
</script>
