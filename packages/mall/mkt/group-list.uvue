<template>
  <scroll-view class="sc" style="flex: 1;">
    <view class="row" v-for="r in rows" :key="r.productId" @click="go(r.productId)">
      <view class="thumb" />
      <view class="mid">
        <text class="t">{{ r.title }}</text>
        <text class="tag">{{ r.tag }}</text>
        <view class="pr">
          <text class="g">拼团价 ¥{{ r.priceYuan }}</text>
          <text class="o">¥{{ r.lineYuan }}</text>
