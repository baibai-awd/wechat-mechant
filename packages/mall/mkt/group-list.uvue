</template>
<script setup lang="uts">
  import { mockGroupRows, type MockMktRow } from '@/utils/mall-mock.uts'

  const rows = ref<MockMktRow[]>(mockGroupRows())

  function go(pid : string) : void {
    uni.navigateTo({ url: '/packages/mall/mkt/group-detail?productId=' + pid })
  }
</script>
