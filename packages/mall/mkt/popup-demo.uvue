<template>
  <scroll-view class="sc" style="flex: 1;">
    <text class="tip">以下为 uni 原生弹窗能力演示，用于运营位 AB（与商城业务无关时可忽略）。</text>
    <view class="btn" @click="d1">
      <text class="btn-t">showModal 确认</text>
    </view>
    <view class="btn" @click="d2">
      <text class="btn-t">showActionSheet</text>
    </view>
    <view class="btn ghost" @click="d3">
      <text class="btn-g">showToast</text>
    </view>
  </scroll-view>
</template>
<script setup lang="uts">
  function d1() : void {
    uni.showModal({
      title: '提示',
      content: '这是一个演示对话框',
      showCancel: true
    })
  }
  function d2() : void {
    uni.showActionSheet({
      itemList: ['选项 A', '选项 B', '选项 C']
    })
  }
  function d3() : void {
    uni.showToast({ title: '操作成功', icon: 'success' })
  }
</script>
