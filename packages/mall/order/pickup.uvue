<template>
  <scroll-view class="sc" style="flex: 1;">
    <text class="intro">以下为附近自提点（演示数据），下单时可选自提并凭码取货。</text>
    <view class="card" v-for="(p, i) in points" :key="'p' + i.toString()" @click="pick(i)">
      <text class="name">{{ p.name }}</text>
      <text class="addr">{{ p.addr }}</text>
      <text class="time">营业时间 {{ p.time }}</text>
    </view>
  </scroll-view>
</template>
<script setup lang="uts">
  const points = [
    { name: '朝阳驿站 A', addr: '朝阳区建国路 100 号一层服务台', time: '9:00-21:00' },
    { name: '浦东提货点 B', addr: '浦东新区世纪大道 88 号 B1', time: '10:00-20:00' },
    { name: '城西便民仓 C', addr: '西湖区文三路 200 号', time: '8:00-22:00' }
  ]

  function pick(i : number) : void {
    uni.showToast({ title: '已选：' + points[i].name, icon: 'none' })
  }
</script>
