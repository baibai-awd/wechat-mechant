<template>
  <scroll-view class="sc" style="flex: 1;">
    <view class="card">
      <text class="q">{{ item.q }}</text>
      <view class="ans">
        <text class="lab">官方回复</text>
        <text class="a">{{ item.a }}</text>
      </view>
    </view>
  </scroll-view>
</template>
<script setup lang="uts">
  import { findMockQa, type MockQa } from '@/utils/mall-mock.uts'

  const item = ref<MockQa>(findMockQa(''))

  onLoad((options : OnLoadOptions) => {
    const id = options['id'] as string
    if (id != null && id.length > 0) {
      item.value = findMockQa(id)
    }
  })
</script>
