        <view class="cover">
          <text class="play">▶</text>
        </view>
        <text class="t">{{ v }}</text>
      </view>
    </view>
  </scroll-view>
</template>
<script setup lang="uts">
  const clips = ['好物开箱 · 30s', '成分党测评', '穿搭速览', '厨房小电推荐']

  function play(i : number) : void {
