<template>
  <scroll-view class="sc" style="flex: 1;">
    <view class="card" v-for="n in list" :key="n.id" @click="go(n.id)">
      <view class="cover">
        <text class="cov-t">{{ n.coverHint }}</text>
      </view>
      <view class="mid">
        <text class="t">{{ n.title }}</text>
        <text class="lk">♥ {{ n.likes }}</text>
