</template>
<script setup lang="uts">
  import { mockNotes, type MockNote } from '@/utils/mall-mock.uts'

  const list = ref<MockNote[]>(mockNotes())

  function go(id : string) : void {
    uni.navigateTo({ url: '/packages/mall/content/note-detail?id=' + id })
  }
</script>
