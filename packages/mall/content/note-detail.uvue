<template>
  <scroll-view class="sc" style="flex: 1;">
    <view class="hero">
      <text class="tag">{{ note.coverHint }}</text>
    </view>
    <view class="body">
      <text class="t">{{ note.title }}</text>
      <text class="meta">种草笔记 · ♥ {{ note.likes }} · 演示内容</text>
      <text class="p" v-for="(line, i) in paras" :key="'x' + i.toString()">{{ line }}</text>
    </view>
  </scroll-view>
</template>
<script setup lang="uts">
  import { findMockNote, type MockNote } from '@/utils/mall-mock.uts'

  const note = ref<MockNote>(findMockNote(''))
  const paras = [
    '开篇：这次分享的入手渠道与价格区间，供大家参考。',
    '使用感受：整体做工扎实，细节对得起价位；若对肤色有要求建议先看实拍。',
    '总结：值得回购，等活动凑单更划算。',
    '（以上为用户 UGC 演示文案，接 CMS 后可替换为富文本）'
  ]

  onLoad((options : OnLoadOptions) => {
    const id = options['id'] as string
    if (id != null && id.length > 0) {
      note.value = findMockNote(id)
    }
  })
</script>
