<template>
  <view class="wrap">
    <view class="search-bar">
      <view class="inp-wrap">
        <text v-if="kw.length === 0" class="inp-ph">搜索商品 / 品牌</text>
        <input class="inp" :value="kw" @input="onKw" @confirm="doSearch" />
      </view>
      <text class="go" @click="doSearch">搜索</text>
    </view>
    <text class="h">热门搜索</text>
    <view class="tags">
      <text class="tag" v-for="(t, i) in hots" :key="'h' + i.toString()" @click="tapHot(t)">{{ t }}</text>
    </view>
  </view>
</template>
<script setup lang="uts">
  const kw = ref('')
  const hots = ['耳机', '保温杯', '示例商品', '数码']
  function onKw(e : UniInputEvent) {
    kw.value = e.detail.value
  }
  function doSearch() : void {
    uni.navigateTo({ url: '/packages/mall/shop/search-result?kw=' + encodeURIComponent(kw.value) })
  }
  function tapHot(t : string) : void {
    kw.value = t
    doSearch()
  }
</script>
<style>
.wrap {
  flex: 1;
  background-color: #f2f2f7;
  padding: 12px 16px 24px;
  flex-direction: column;
}
.search-bar {
  flex-direction: row;
  align-items: center;
  background-color: #ffffff;
  border-radius: 16px;
  border-width: 1px;
  border-color: #e5e5ea;
  padding: 4px 4px 4px 14px;
}
.inp-wrap {
  flex: 1;
  position: relative;
  flex-direction: column;
}
.inp-ph {
  position: absolute;
  left: 8px;
  top: 10px;
  font-size: 15px;
  color: #9ca3af;
  z-index: 0;
  pointer-events: none;
}
.inp {
  flex: 1;
  font-size: 15px;
  color: #111827;
  padding: 10px 8px;
  z-index: 1;
  background-color: transparent;
}
.go {
  padding: 10px 16px;
  font-size: 15px;
  font-weight: 600;
  color: #ffffff;
  background-color: #059669;
  border-radius: 12px;
}
.h {
  margin-top: 24px;
  font-size: 14px;
  font-weight: 600;
  color: #6b7280;
}
.tags {
  margin-top: 12px;
  flex-direction: row;
  flex-wrap: wrap;
}
.tag {
  margin-right: 10px;
  margin-bottom: 10px;
  padding: 8px 14px;
  border-radius: 16px;
  background-color: #ffffff;
  border-width: 1px;
  border-color: #e5e5ea;
  font-size: 13px;
  color: #374151;
}
</style>
