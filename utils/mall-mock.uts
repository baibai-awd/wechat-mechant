export type MockMktRow = {
  productId: string
  title: string
  priceYuan: string
  lineYuan: string
  tag: string
  cover: string
  stock: number
  sold: number
  limitText: string
  statusText: string
}

export function mockFlashRows(): MockMktRow[] {
  const p1 = getProductBrief('p1')
  const p3 = getProductBrief('p3')
  const p4 = getProductBrief('p4')
  return [
    { productId: 'p1', title: p1.title + ' · 秒杀', priceYuan: '79.00', lineYuan: p1.priceYuan, tag: '仅剩 12 件', cover: p1.cover, stock: 80, sold: 68, limitText: '限购 1 件', statusText: '抢购中' },
    { productId: 'p3', title: p3.title + ' · 秒杀', priceYuan: '49.00', lineYuan: p3.priceYuan, tag: '即将售罄', cover: p3.cover, stock: 60, sold: 53, limitText: '限购 2 件', statusText: '抢购中' },
    { productId: 'p4', title: p4.title + ' · 秒杀', priceYuan: '168.00', lineYuan: p4.priceYuan, tag: '24h 榜 TOP', cover: p4.cover, stock: 120, sold: 86, limitText: '限购 1 件', statusText: '抢购中' }
  ]
}

export function findMockFlashRow(pid: string): MockMktRow {
  const rows = mockFlashRows()
  for (let i = 0; i < rows.length; i++) {
    if (rows[i].productId === pid) {
      return rows[i]
    }
  }
  return rows[0]
}

