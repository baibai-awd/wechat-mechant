/** 商城分包演示数据（可后续替换为 uniCloud） */

import { getProductBrief, type MallProductBrief } from '@/utils/mall-catalog.uts'

export type MockOrderRow = {
  id: string
  statusText: string
  goodsTitle: string
  spec: string
  priceYuan: string
  count: number
  time: string
  productId: string
  cover: string
  /** 整单实付（含运费），与云端 total_cent 一致 */
  payTotalYuan: string
}

export function mockOrders(): MockOrderRow[] {
  const now = new Date()
  const pad = (n: number) => n.toString().padStart(2, '0')
  const y = now.getFullYear()
  const m = now.getMonth() + 1
  const d = now.getDate()
  const today = `${y}-${pad(m)}-${pad(d)}`

  function daysAgo(days: number, hour: number, min: number): string {
    const dt = new Date(now.getTime() - days * 86400000)
    return `${dt.getFullYear()}-${pad(dt.getMonth() + 1)}-${pad(dt.getDate())} ${pad(hour)}:${pad(min)}`
  }

  return [
    { id: 'ORD' + y + pad(m) + '001', statusText: '待付款', goodsTitle: '示例商品 B', spec: '默认规格 ×1', priceYuan: '128.00', count: 1, time: today + ' 08:00', productId: 'p2', cover: '', payTotalYuan: '136.00' },
    { id: 'ORD' + y + pad(m) + '002', statusText: '待发货', goodsTitle: '示例商品 A', spec: '默认规格 ×1', priceYuan: '99.00', count: 1, time: daysAgo(1, 10, 20), productId: 'p1', cover: '', payTotalYuan: '107.00' },
    { id: 'ORD' + y + pad(m) + '003', statusText: '待收货', goodsTitle: '示例商品 D', spec: '默认规格 ×2', priceYuan: '199.00', count: 2, time: daysAgo(3, 16, 5), productId: 'p4', cover: '', payTotalYuan: '406.00' },
    { id: 'ORD' + y + pad(m) + '004', statusText: '已完成', goodsTitle: '示例商品 C', spec: '默认规格 ×1', priceYuan: '59.00', count: 1, time: daysAgo(7, 9, 12), productId: 'p3', cover: '', payTotalYuan: '67.00' }
  ]
}

export function findMockOrder(id: string): MockOrderRow {
  const rows = mockOrders()
  for (let i = 0; i < rows.length; i++) {
    if (rows[i].id === id) {
      return rows[i]
    }
  }
  return rows[0]
}

