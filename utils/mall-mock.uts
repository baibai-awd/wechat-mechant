export type MockAfterSalesStep = {
  title: string
  time: string
  desc: string
}

export type MockAfterSales = {
  id: string
  statusKey: string
  statusText: string
  type: number
  reason: string
  amount: string
  time: string
  goodsTitle: string
  spec: string
  cover: string
  images: string[]
  steps: MockAfterSalesStep[]
  desc: string
}

export function mockAfterSales(): MockAfterSales[] {
  const now = new Date()
  const pad = (n: number) => n.toString().padStart(2, '0')
  const y = now.getFullYear()
  const m = now.getMonth() + 1
  const d = now.getDate()
  const today = `${y}-${pad(m)}-${pad(d)}`
  const yesterday = `${y}-${pad(m)}-${pad(d - 1)}`

  return [
    {
      id: 'AS' + y + pad(m) + '001',
      statusKey: 'progress',
      statusText: '处理中',
      type: 1,
      reason: '商品破损',
      amount: '99.00',
      time: today + ' 10:30',
      goodsTitle: '示例商品 A',
      spec: '默认规格 ×1',
      cover: '',
      images: [],
      desc: '收到商品外包装破损，商品本身也有划痕，希望退货退款。',
      steps: [
        { title: '提交售后申请', time: today + ' 10:30', desc: '等待商家处理' },
        { title: '商家处理中', time: today + ' 14:20', desc: '商家已审核通过，请按下方地址退货' },
        { title: '待买家退货', time: '', desc: '请在 7 天内寄回商品' }
      ]
    },
    {
      id: 'AS' + y + pad(m) + '002',
      statusKey: 'success',
      statusText: '退款成功',
      type: 0,
      reason: '商品与描述不符',
      amount: '59.00',
      time: yesterday + ' 09:15',
      goodsTitle: '示例商品 C',
      spec: '默认规格 ×1',
      cover: '',
      images: [],
      desc: '实物与图片描述差异较大，申请全额退款。',
      steps: [
        { title: '提交售后申请', time: yesterday + ' 09:15', desc: '' },
        { title: '商家处理中', time: yesterday + ' 11:00', desc: '商家同意退款' },
        { title: '退款完成', time: yesterday + ' 16:30', desc: '退款已原路返回支付账户' }
      ]
    },
    {
      id: 'AS' + y + pad(m) + '003',
      statusKey: 'rejected',
      statusText: '已拒绝',
      type: 1,
      reason: '其他',
      amount: '199.00',
      time: yesterday + ' 20:00',
      goodsTitle: '示例商品 D',
      spec: '默认规格 ×2',
      cover: '',
      images: [],
      desc: '商品有质量问题，要求退货退款。',
      steps: [
        { title: '提交售后申请', time: yesterday + ' 20:00', desc: '' },
        { title: '商家处理中', time: today + ' 09:00', desc: '商家拒绝了申请，原因：超出退货期限' },
        { title: '可联系客服申诉', time: '', desc: '如有异议请联系平台客服' }
      ]
    }
  ]
}

export function findMockAfterSales(id: string): MockAfterSales {
  const rows = mockAfterSales()
  for (let i = 0; i < rows.length; i++) {
    if (rows[i].id === id) {
      return rows[i]
    }
  }
  return rows[0]
}

