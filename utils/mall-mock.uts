export function filterProductsByKw(list: MallProductBrief[], kw: string): MallProductBrief[] {
  if (kw.length === 0) {
    return list
  }
  const out: MallProductBrief[] = []
  const lower = kw.toLowerCase()
  for (let i = 0; i < list.length; i++) {
    const t = list[i].title.toLowerCase()
    if (t.indexOf(lower) >= 0) {
      out.push(list[i])
    }
  }
  return out
}

export function getBriefProduct(pid: string): MallProductBrief {
  return getProductBrief(pid)
}
