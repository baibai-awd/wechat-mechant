{
  "bsonType": "object",
  "description": "uni-id 用户表（仅允许云函数/云对象读写；客户端勿直连）",
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": { "description": "用户 ID" },
    "username": { "bsonType": "string", "description": "账号，本演示与 mobile 一致" },
    "mobile": { "bsonType": "string" },
    "mobile_confirmed": { "bsonType": "int", "description": "1=已确认" },
    "password": { "bsonType": "string", "description": "加密后密码" },
    "nickname": { "bsonType": "string" },
    "register_date": { "bsonType": "timestamp" },
    "register_ip": { "bsonType": "string" },
    "role": { "bsonType": "array", "description": "角色 id 列表" },
    "token": { "bsonType": "array", "description": "token 列表" },
    "last_login_date": { "bsonType": "timestamp" },
    "last_login_ip": { "bsonType": "string" },
    "status": { "bsonType": "int", "description": "0 正常" },
    "valid_token_date": { "bsonType": "timestamp", "description": "可选：早于该时间的 token 失效" }
  }
}
