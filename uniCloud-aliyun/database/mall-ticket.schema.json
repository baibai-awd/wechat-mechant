{
  "bsonType": "object",
  "required": ["user_id", "type", "status"],
  "permission": {
    "read": "doc.user_id == auth.uid",
    "create": "auth.uid != null",
    "update": "doc.user_id == auth.uid",
    "delete": false
  },
  "properties": {
    "_id": { "description": "系统自动生成" },
    "user_id": { "bsonType": "string" },
    "type": { "bsonType": "string", "description": "refund | return — 仅退款 / 退货退款" },
    "order_id": { "bsonType": "string" },
    "reason": { "bsonType": "string", "description": "退款原因" },
    "amount": { "bsonType": "string", "description": "退款金额（元）" },
    "desc": { "bsonType": "string", "description": "问题描述" },
    "images": { "bsonType": "array", "description": "凭证图片" },
    "status": { "bsonType": "string", "description": "open | processing | approved | rejected | closed" },
    "replies": { "bsonType": "array", "description": "沟通记录 [{content, time, from}]" },
    "created_at": { "bsonType": "number" },
    "updated_at": { "bsonType": "number" }
  }
}
