{
  "bsonType": "object",
  "required": ["user_id", "contact_name", "phone", "detail"],
  "permission": {
    "read": "doc.user_id == auth.uid",
    "create": "auth.uid != null",
    "update": "doc.user_id == auth.uid",
    "delete": "doc.user_id == auth.uid"
  },
  "properties": {
    "_id": { "description": "系统自动生成" },
    "user_id": { "bsonType": "string", "description": "uni-id uid" },
    "contact_name": { "bsonType": "string" },
    "phone": { "bsonType": "string" },
    "region": { "bsonType": "array", "description": "省市区编码或名称数组" },
    "detail": { "bsonType": "string", "description": "详细地址" },
    "is_default": { "bsonType": "bool", "description": "是否默认" },
    "created_at": { "bsonType": "number" },
    "updated_at": { "bsonType": "number" }
  }
}
