  uni-app.uni-app--showtabbar uni-page-body,
  uni-page-body {
    --tab-bar-height: 0px !important;
    --uni-safe-area-inset-bottom: 0px !important;
  }

  uni-app.uni-app--showtabbar uni-page-body::after,
  uni-page-body::after {
    content: none !important;
    display: none !important;
    height: 0 !important;
    min-height: 0 !important;
  }

  uni-tabbar .uni-tabbar,
  .uni-top-window uni-tabbar .uni-tabbar {
    background-color: #ffffff !important;
  }

  uni-tabbar .uni-placeholder,
  uni-tabbar .uni-tabbar__placeholder,
  uni-tabbar .uni-tabbar-placeholder,
  .uni-tabbar__placeholder,
  .uni-tabbar-placeholder {
    display: none !important;
    height: 0 !important;
    min-height: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
  }
  /* #endif */

  /* #ifdef MP-WEIXIN */
  page {
    background-color: #efeff4;
  }
  /* #endif */

  .global-text {
    color: #007aff;
    font-size: 18px;
    font-weight: bold;
  }

  .global-box {
    background-color: #e1f5ff;
    padding: 10px;
    margin: 10px;
    border-radius: 8px;
    border: 2px solid #007aff;
  }

  .global-important-class {
    background-color: #c6deff !important;
    border-color: #3d7cf5 !important;
  }

  .global-important-box {
    background-color: #fff6c2 !important;
    border: #fcdf02 solid 3px !important;
  }

  .issue-27180-box {
    background-color: red;
  }
</style>
